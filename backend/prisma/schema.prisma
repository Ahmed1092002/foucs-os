// Focus OS — Prisma schema
// See docs/08-database-schema.md for the full design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Users
// ============================================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  learningAreas   LearningArea[]
  subjects        Subject[]
  studySessions   StudySession[]
  dailyPlans      DailyPlan[]
  dailyReviews    DailyReview[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

// ============================================================================
// Auth
// ============================================================================

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
// Learning Areas
// ============================================================================

model LearningArea {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  color      String
  icon       String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects Subject[]

  @@index([userId])
  @@index([userId, archivedAt])
  @@map("learning_areas")
}

// ============================================================================
// Subjects
// ============================================================================

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  areaId      String   @map("area_id") @db.Uuid
  name        String
  description String?
  color       String?
  targetHours Decimal  @default(0) @map("target_hours") @db.Decimal(6, 2)
  status      String   @default("active")
  priority    Int      @default(0)
  deadline    DateTime? @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  area         LearningArea  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  studySessions StudySession[]
  dailyPlanItems DailyPlanItem[]
  courses       Course[]

  @@index([userId])
  @@index([areaId])
  @@index([userId, status])
  @@map("subjects")
}

// ============================================================================
// Study Sessions
// ============================================================================

model StudySession {
  id                       String   @id @db.Uuid
  userId                   String   @map("user_id") @db.Uuid
  subjectId                String?  @map("subject_id") @db.Uuid
  topic                    String?
  plannedDurationSeconds   Int      @map("planned_duration_seconds")
  startedAt                DateTime @map("started_at") @db.Timestamptz(6)
  endedAt                  DateTime? @map("ended_at") @db.Timestamptz(6)
  actualDurationSeconds    Int?     @map("actual_duration_seconds")
  pausedIntervalsSeconds   Int      @default(0) @map("paused_intervals_seconds")
  state                    String   @default("running")
  goalText                 String?  @map("goal_text")
  goalResult               String?  @map("goal_result")
  focusRating              Int?     @map("focus_rating")
  energyRating             Int?     @map("energy_rating")
  notes                    String?
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, state])
  @@index([subjectId, startedAt(sort: Desc)])
  @@map("study_sessions")
}

// ============================================================================
// Daily Planner
// ============================================================================

model DailyPlan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  planDate  DateTime @map("plan_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items DailyPlanItem[]

  @@unique([userId, planDate])
  @@map("daily_plans")
}

model DailyPlanItem {
  id              String   @id @default(uuid()) @db.Uuid
  dailyPlanId     String   @map("daily_plan_id") @db.Uuid
  subjectId       String   @map("subject_id") @db.Uuid
  startTime       DateTime @map("start_time") @db.Time(6)
  durationSeconds Int      @map("duration_seconds")
  orderIndex      Int      @default(0) @map("order_index")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([dailyPlanId, orderIndex])
  @@map("daily_plan_items")
}

// ============================================================================
// Course tree (V1) — see docs/08-database-schema.md
// ============================================================================

model Course {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  name      String
  description String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  modules Module[]

  @@index([subjectId])
  @@map("courses")
}

model Module {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  name      String
  description String?
  orderIndex Int     @default(0) @map("order_index")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, orderIndex])
  @@map("modules")
}

model Lesson {
  id        String   @id @default(uuid()) @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  name      String
  description String?
  // not_started | in_progress | completed
  status    String   @default("not_started")
  orderIndex Int     @default(0) @map("order_index")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, orderIndex])
  @@map("lessons")
}

// ============================================================================
// Daily Reviews (V1 — table created in MVP to avoid migration churn)
// ============================================================================

model DailyReview {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  reviewDate         DateTime @map("review_date") @db.Date
  productivityRating Int?     @map("productivity_rating")
  energyRating       Int?     @map("energy_rating")
  focusRating        Int?     @map("focus_rating")
  wentWell           String?  @map("went_well")
  blockedBy          String?  @map("blocked_by")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewDate])
  @@map("daily_reviews")
}