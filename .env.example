# Focus OS — Environment Variables Template
# Copy to .env and fill in values
# NEVER commit .env to version control

# ──────────────────────────────────────────────
# Backend (NestJS)
# ──────────────────────────────────────────────
# Database (PostgreSQL)
# Local Docker: postgresql://focus:focus_dev_password@localhost:5434/focus_os
# Render:       postgresql://user:pass@host:5432/focus_os?sslmode=require
DATABASE_URL=postgresql://focus:focus_dev_password@localhost:5434/focus_os

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated origins
# Dev: http://localhost:3000 (Flutter web), http://10.0.2.2:3000 (Android emulator)
# Prod: https://your-vercel-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000,http://localhost:5000

# ──────────────────────────────────────────────
# Frontend (Flutter Web) — build-time constants
# ──────────────────────────────────────────────
# Pass via --dart-define at build time:
# flutter build web --release --dart-define=API_BASE_URL=https://your-api.onrender.com/api/v1
# API_BASE_URL=https://your-api.onrender.com/api/v1

# ──────────────────────────────────────────────
# Mobile (Android) — signing (optional, for release builds)
# ──────────────────────────────────────────────
# Store in mobile/android/key.properties (gitignored):
# storePassword=your_keystore_password
# keyPassword=your_key_password
# keyAlias=focus_os_key
# storeFile=../upload-keystore.jks